# Names only. Never put real values in this file.
# Copy to a git-ignored .env on the host and fill in values there.

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the GitHub App private key file inside the container (mounted read-only)
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Sessions
SESSION_SECRET=

# Data stores
DATABASE_URL=
REDIS_URL=

# Public origin of the site, used for redirects and cookies
PUBLIC_BASE_URL=
