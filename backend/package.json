{
  "name": "@codelens/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "jest --config jest.config.js --selectProjects unit --passWithNoTests",
    "test:contract": "jest --config jest.config.js --selectProjects contract --passWithNoTests",
    "test:integration": "jest --config jest.config.js --selectProjects integration --passWithNoTests --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "~11.2.6",
    "@nestjs/core": "~11.2.6",
    "@nestjs/platform-express": "~11.2.6",
    "@prisma/client": "~6.19.3",
    "bullmq": "~5.81.5",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "~11.2.6",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "~22.20.4",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "eslint": "~9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "~6.19.3",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "^2.9.1"
  }
}
